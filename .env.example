# Gmail SMTP. The app password is created on the atelier Google account.
NUXT_GMAIL_USER=theseedatelier.sg@gmail.com
NUXT_GMAIL_APP_PASSWORD=

# Production alias, used in absolute links once a deployment exists.
NUXT_PUBLIC_SITE_URL=https://the-seed-atelier.vercel.app

# Studio publish target. Vercel fills these from the connected Git repository.
STUDIO_GITHUB_OWNER=
STUDIO_GITHUB_REPO=
STUDIO_GITHUB_BRANCH=main

# GitHub sign-in for /_studio. Callback: https://<alias>.vercel.app/__nuxt_studio/auth/github
STUDIO_GITHUB_CLIENT_ID=
STUDIO_GITHUB_CLIENT_SECRET=

# Required for Google sign-in, which cannot push commits itself.
STUDIO_GITHUB_TOKEN=

# Google sign-in for /_studio. Callback: https://<alias>.vercel.app/__nuxt_studio/auth/google
STUDIO_GOOGLE_CLIENT_ID=
STUDIO_GOOGLE_CLIENT_SECRET=
STUDIO_GOOGLE_MODERATORS=theseedatelier.sg@gmail.com
